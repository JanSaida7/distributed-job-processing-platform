# Application settings
APP_ENV=development
APP_NAME=distributed-job-processing-platform
API_V1_PREFIX=/api/v1

# Database configuration (planned for Phase 2)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/job_processing

# Authentication configuration (planned for Phase 4)
JWT_SECRET_KEY=replace-with-a-local-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis configuration (planned for Phase 5)
REDIS_URL=redis://localhost:6379/0

# Browser clients allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
